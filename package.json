{
  "name": "aurorra-intake",
  "private": true,
  "version": "0.0.0",
  "description": "React intake workflow for PDF and TIFF document selection, upload, session provisioning, and indexing in the Tabularium AI platform.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Tabularium AI",
  "repository": {
    "type": "git",
    "url": "https://github.com/TabulariumAI/aurorra_intake.git"
  },
  "bugs": {
    "url": "https://github.com/TabulariumAI/aurorra_intake/issues"
  },
  "homepage": "https://github.com/TabulariumAI/aurorra_intake#readme",
  "keywords": [
    "document-intake",
    "document-processing",
    "indexing",
    "pdf",
    "tiff",
    "react",
    "tabularium-ai"
  ],
  "main": "./src/public-api.ts",
  "module": "./src/public-api.ts",
  "types": "./src/public-api.ts",
  "exports": {
    ".": {
      "types": "./src/public-api.ts",
      "import": "./src/public-api.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "lint:boundary": "node scripts/check-boundary.cjs"
  },
  "dependencies": {
    "@tabulariumai/aurora-lens": "^0.2.1",
    "aurora-core": "file:../aurora_core",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
